@model List<Point>
@{
    ViewData["Title"] = "Пункти";
    ViewData["Description"] = "Список пунктів незламності: адреси, графік, послуги й поточний статус. Знайдіть пункт за населеним пунктом чи послугою.";
    var status = ViewData["status"] as PointStatus?;
}
<div class="page-head">
    <h1>Пункти незламності</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Додати пункт</a>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <input name="q" value="@ViewData["q"]" class="form-control" placeholder="Назва, адреса або населений пункт" aria-label="Пошук" />
    </div>
    <div class="col-md-3">
        <select name="serviceId" asp-items="ViewBag.Services" class="form-select" aria-label="Послуга">
            <option value="">Усі послуги</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select" aria-label="Статус">
            <option value="">Будь-який статус</option>
            @foreach (var s in Enum.GetValues<PointStatus>())
            {
                <option value="@s" selected="@(status == s)">@s.DisplayName()</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button class="btn btn-outline-primary">Знайти</button>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">За цими умовами пунктів немає. Спробуйте прибрати фільтр за послугою чи статусом.</div>
}
else
{
    <ul class="point-list">
        @foreach (var p in Model)
        {
            <partial name="_PointRow" model="p" />
        }
    </ul>
}
