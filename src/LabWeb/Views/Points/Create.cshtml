@model PointFormViewModel
@{
    ViewData["Title"] = "Новий пункт";
}
<h1 class="mb-4">Новий пункт</h1>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="panel">
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Створити</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
    </div>
</form>
@section Head { <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" /> }
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/point-map.js" asp-append-version="true"></script>
}
