@model PointFormViewModel
@{
    ViewData["Title"] = $"Редагування: {Model.Point.Name}";
}
<h1 class="h3 mb-4">Редагування пункту</h1>
<form asp-action="Edit" asp-route-id="@Model.Point.Id" method="post" enctype="multipart/form-data" class="card card-body">
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Зберегти</button>
        <a asp-action="Details" asp-route-id="@Model.Point.Id" class="btn btn-outline-secondary">Скасувати</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
