@model Point
@{
    ViewData["Title"] = Model.Name;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
@section Head { <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" /> }
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/point-map.js" asp-append-version="true"></script>
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Пункти</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="row g-5">
    <div class="col-lg-5">
        <img src="@(Model.PhotoPath ?? Url.Content("~/img/placeholder.svg"))" class="point-photo" alt="@Model.Name" />
        <div class="point-map mt-3" data-point-map data-status="@Model.Status"
             data-lat="@Model.Latitude.ToString(inv)" data-lng="@Model.Longitude.ToString(inv)"
             aria-label="Пункт на мапі"></div>
        <a class="d-inline-block mt-2" asp-controller="Map" asp-action="Index">Усі пункти на мапі</a>
    </div>
    <div class="col-lg-7">
        <partial name="_StatusBadge" model="Model.Status" />
        <h1 class="mt-2 mb-1">@Model.Name</h1>
        <p class="text-muted mb-3">@Model.Settlement, @Model.Address</p>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }

        <div class="d-flex flex-wrap gap-2">
            @foreach (var s in Model.Services.OrderBy(s => s.Name))
            {
                <span class="chip"><i class="bi @s.Icon" aria-hidden="true"></i>@s.Name</span>
            }
        </div>

        <dl class="facts">
            <dt>@Html.DisplayNameFor(m => m.Schedule)</dt>
            <dd>@(Model.Schedule ?? "Не вказано")</dd>
            <dt>@Html.DisplayNameFor(m => m.Capacity)</dt>
            <dd>@Model.Capacity</dd>
            <dt>@Html.DisplayNameFor(m => m.Operator)</dt>
            <dd>
                @if (Model.Operator is not null)
                {
                    <a asp-controller="Operators" asp-action="Details" asp-route-id="@Model.OperatorId">@Model.Operator.Name</a><br />
                    <a href="tel:@Model.Operator.Phone">@Model.Operator.Phone</a>
                }
            </dd>
            <dt>Координати</dt>
            <dd>@Model.Latitude.ToString("0.00000", inv), @Model.Longitude.ToString("0.00000", inv)</dd>
            <dt>@Html.DisplayNameFor(m => m.UpdatedAt)</dt>
            <dd>@Model.UpdatedAt.ToLocalString()</dd>
        </dl>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Reports" asp-action="Create" asp-route-pointId="@Model.Id" class="btn btn-primary">Додати звіт про стан</a>
            @if (CurrentUser.CanEdit(Model.Operator?.CommunityId))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Редагувати</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Видалити</a>
            }
        </div>
    </div>
</div>

<h2 class="mt-5 mb-3">Звіти про стан</h2>
@if (Model.Reports.Count == 0)
{
    <p class="text-muted">Звітів ще немає. Перший звіт задасть статус пункту.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr><th>Час</th><th>Статус</th><th class="text-center">Світло</th><th class="text-center">Зв'язок</th><th class="text-center">Тепло</th><th>Людей</th><th>Коментар</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Reports)
                {
                    <tr>
                        <td class="text-nowrap">@r.CreatedAt.ToLocalString()</td>
                        <td><partial name="_StatusBadge" model="r.Status" /></td>
                        <td class="text-center"><partial name="~/Views/Reports/_Flag.cshtml" model="r.HasElectricity" /></td>
                        <td class="text-center"><partial name="~/Views/Reports/_Flag.cshtml" model="r.HasInternet" /></td>
                        <td class="text-center"><partial name="~/Views/Reports/_Flag.cshtml" model="r.HasHeating" /></td>
                        <td>@r.Occupancy</td>
                        <td class="small text-muted">@r.Comment</td>
                        <td class="text-end"><a asp-controller="Reports" asp-action="Details" asp-route-id="@r.Id">Відкрити</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <a asp-controller="Reports" asp-action="Index" asp-route-pointId="@Model.Id">Усі звіти цього пункту</a>
}
