@{
    var seoController = ViewContext.RouteData.Values["controller"]?.ToString();
    var seoAction = ViewContext.RouteData.Values["action"]?.ToString();
    var noIndex = seoController is "Account" or "Community" or "Analytics" or "Board" or "Assistant" or "Notifications"
        || seoAction is "Create" or "Edit" or "Delete" or "Error";
    var pageTitle = ViewData["Title"] is string title ? $"{title} — Незламні" : "Незламні";
    var pageDescription = ViewData["Description"] as string
        ?? "Мапа пунктів незламності в Україні: де зараз є світло, зв'язок і тепло, що працює поруч і як туди дістатися.";
    var canonical = ViewData["Canonical"] as string
        ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}";
}
<!DOCTYPE html>
<html lang="uk" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />
    <link rel="canonical" href="@canonical" />
    @if (noIndex)
    {
        <meta name="robots" content="noindex" />
    }
    <meta property="og:site_name" content="Незламні" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@canonical" />
    @if (ViewData["OgImage"] is string ogImage)
    {
        <meta property="og:image" content="@ogImage" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600&family=Unbounded:wght@500;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    @await RenderSectionAsync("Head", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-lamp" aria-hidden="true"></span>Незламні
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    @{ var current = ViewContext.RouteData.Values["controller"]?.ToString(); }
                    <ul class="navbar-nav ms-auto gap-lg-2">
                        <li class="nav-item"><a class="nav-link @(current == "Map" ? "active" : "")" asp-controller="Map" asp-action="Index">Мапа</a></li>
                        <li class="nav-item"><a class="nav-link @(current == "Points" ? "active" : "")" asp-controller="Points" asp-action="Index">Пункти</a></li>
                        <li class="nav-item"><a class="nav-link @(current == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">Звіти</a></li>
                        <li class="nav-item"><a class="nav-link @(current == "Operators" ? "active" : "")" asp-controller="Operators" asp-action="Index">Оператори</a></li>
                        <li class="nav-item"><a class="nav-link @(current == "Services" ? "active" : "")" asp-controller="Services" asp-action="Index">Послуги</a></li>
                        <li class="nav-item"><a class="nav-link @(current == "Assistant" ? "active" : "")" asp-controller="Assistant" asp-action="Index">Асистент</a></li>
                        @if (CurrentUser.IsSignedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(current == "Notifications" ? "active" : "")" asp-controller="Notifications" asp-action="Index" aria-label="Сповіщення"><i class="bi bi-bell" aria-hidden="true"></i><span class="d-lg-none ms-2">Сповіщення</span>@if (CurrentUser.UnreadNotifications > 0)
                                {<span class="nav-badge">@CurrentUser.UnreadNotifications</span>}</a>
                            </li>
                            <li class="nav-item dropdown user-menu">
                                <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="user-initial" aria-hidden="true">@CurrentUser.User!.Name[..1]</span>@CurrentUser.User.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (CurrentUser.Community is { } community)
                                    {
                                        <li><span class="dropdown-item-text user-community">@community.Name</span></li>
                                        <li><a class="dropdown-item" asp-controller="Community" asp-action="Index">Моя громада</a></li>
                                        <feature name="@Features.Analytics">
                                            <li><a class="dropdown-item" asp-controller="Analytics" asp-action="Index">Аналітика</a></li>
                                        </feature>
                                        <feature name="@Features.SharedBoard">
                                            <li><a class="dropdown-item" asp-controller="Board" asp-action="Index">Штабна мапа</a></li>
                                        </feature>
                                        <feature name="@Features.Analytics" negate="true">
                                            <li><a class="dropdown-item" asp-controller="Community" asp-action="Premium">Аналітика <span class="plan-tag">Premium</span></a></li>
                                        </feature>
                                        <feature name="@Features.SharedBoard" negate="true">
                                            <li><a class="dropdown-item" asp-controller="Community" asp-action="Premium">Штабна мапа <span class="plan-tag">Premium</span></a></li>
                                        </feature>
                                    }
                                    else
                                    {
                                        <li><a class="dropdown-item" asp-controller="Community" asp-action="Start">Приєднатися до громади</a></li>
                                    }
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Профіль і API-токен</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Вийти</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="btn btn-sm btn-outline-light ms-lg-2 mt-2 mt-lg-0" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Увійти</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="@(ViewData["FullWidth"] is true ? "main-full" : "container py-4") flex-grow-1">
        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @ok
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрити"></button>
            </div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @err
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрити"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>Незламні, @DateTime.Now.Year</span>
            <span>Проєкт з курсу «WEB-технології»</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
