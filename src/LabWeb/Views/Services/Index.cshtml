@model List<Service>
@{
    ViewData["Title"] = "Послуги";
}
<div class="page-head">
    <h1>Послуги</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Додати послугу</a>
</div>
<div class="row">
    <div class="col-lg-9">
        @foreach (var s in Model)
        {
            <div class="service-tile">
                <span class="icon"><i class="bi @s.Icon" aria-hidden="true"></i></span>
                <div class="flex-grow-1">
                    <h2><a asp-action="Details" asp-route-id="@s.Id">@s.Name</a></h2>
                    <p>@s.Description</p>
                    <p class="small mt-1">Є в пунктах: @s.Points.Count</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary" title="Редагувати" aria-label="Редагувати @s.Name"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger" title="Видалити" aria-label="Видалити @s.Name"><i class="bi bi-trash"></i></a>
                </div>
            </div>
        }
    </div>
</div>
