@{
    ViewData["Title"] = "Вхід";
    var returnUrl = ViewData["returnUrl"] as string;
    var google = ViewData["google"] is true;
    var dev = ViewData["dev"] is true;
}
<div class="auth-page">
    <div class="auth-intro">
        <h1>Вхід для операторів і громад</h1>
        <p class="lead-muted">Мапу бачать усі й без входу. Увійдіть, щоб додавати пункти своєї громади,
            оновлювати їхній стан і отримати токен для API.</p>
    </div>

    <div class="auth-box">
        @if (ViewData["error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        @if (google)
        {
            <form asp-action="Google" method="post">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="btn btn-google w-100">
                    <svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.3 0-9.7-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
                    Увійти через Google
                </button>
            </form>
            <p class="auth-note">Перший вхід створює обліковий запис. Ми зберігаємо лише ім'я та email.</p>
        }
        else if (!dev)
        {
            <p class="text-muted mb-0">Вхід через Google ще не налаштовано на цьому сервері.</p>
        }

        @if (dev)
        {
            <form asp-action="DevLogin" method="post" class="dev-login">
                <p class="dev-login-title">Вхід для розробки</p>
                <p class="auth-note mt-0">Працює лише в режимі Development, без пароля.</p>
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="mb-2">
                    <label for="devEmail" class="form-label">Email</label>
                    <input id="devEmail" name="email" type="email" class="form-control" required placeholder="name@example.com" />
                </div>
                <div class="mb-3">
                    <label for="devName" class="form-label">Ім'я</label>
                    <input id="devName" name="name" class="form-control" placeholder="Як вас показувати" />
                </div>
                <button type="submit" class="btn btn-outline-light w-100">Увійти як розробник</button>
            </form>
        }
    </div>
</div>
