@model HomeViewModel
@{
    ViewData["Title"] = "Головна";
}
<div class="p-4 p-md-5 mb-4 rounded-3 hero">
    <h1 class="display-6 fw-semibold">Пункти незламності поруч</h1>
    <p class="lead mb-4">Де є світло, зв'язок і тепло — актуальні статуси від операторів пунктів.</p>
    <a asp-controller="Points" asp-action="Index" class="btn btn-warning btn-lg"><i class="bi bi-geo-alt"></i> Переглянути пункти</a>
    <a asp-controller="Reports" asp-action="Create" class="btn btn-outline-light btn-lg ms-2"><i class="bi bi-plus-lg"></i> Надіслати звіт</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="card stat"><div class="card-body"><div class="stat-value">@Model.PointsTotal</div><div class="text-muted">Пунктів</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card stat"><div class="card-body"><div class="stat-value text-success">@Model.PointsWorking</div><div class="text-muted">Працюють зараз</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card stat"><div class="card-body"><div class="stat-value">@Model.OperatorsTotal</div><div class="text-muted">Операторів</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card stat"><div class="card-body"><div class="stat-value">@Model.ReportsToday</div><div class="text-muted">Звітів за добу</div></div></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <h2 class="h5 mb-3">Пункти</h2>
        <div class="row g-3">
            @foreach (var p in Model.Points)
            {
                <div class="col-md-6">
                    <partial name="~/Views/Points/_PointCard.cshtml" model="p" />
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <h2 class="h5 mb-3">Останні звіти</h2>
        <ul class="list-group">
            @foreach (var r in Model.LatestReports)
            {
                <li class="list-group-item">
                    <div class="d-flex justify-content-between align-items-start">
                        <a asp-controller="Points" asp-action="Details" asp-route-id="@r.PointId" class="fw-semibold text-decoration-none">@r.Point?.Name</a>
                        <partial name="_StatusBadge" model="r.Status" />
                    </div>
                    <small class="text-muted">@r.CreatedAt.ToLocalString() · @r.Occupancy осіб</small>
                </li>
            }
        </ul>
    </div>
</div>
