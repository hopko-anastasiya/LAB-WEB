@model HomeViewModel
@{
    ViewData["Title"] = "Головна";
    int[][] buildings = [[4, 4], [6, 7], [3, 3], [7, 5], [4, 8], [5, 3], [3, 6], [6, 4], [4, 5]];
    var windows = buildings.SelectMany((b, k) => Enumerable.Range(0, b[0] * b[1]).Select(w => (k, Row: w / b[0], Col: w % b[0]))).ToList();
    var random = new Random(17);
    var order = Enumerable.Range(0, windows.Count).OrderBy(_ => random.Next()).ToList();
    var lit = new Dictionary<int, int>();
    foreach (var i in order.TakeWhile(_ => lit.Count < windows.Count / 5))
    {
        var near = lit.Keys.Any(j => windows[j].k == windows[i].k && Math.Abs(windows[j].Row - windows[i].Row) + Math.Abs(windows[j].Col - windows[i].Col) <= 1);
        if (!near) lit[i] = lit.Count;
    }
    var blinking = order.Skip(lit.Count).Take(8).ToHashSet();
    var index = 0;
}
<section class="hero">
    <h1>Де зараз є світло</h1>
    <p class="hero-lead">Пункти незламності поруч із вами: де можна зарядити телефон, зігрітися й вийти на зв'язок. Статуси оновлюють оператори пунктів.</p>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Points" asp-action="Index" class="btn btn-primary btn-lg">Знайти пункт</a>
        <a asp-controller="Reports" asp-action="Create" class="btn btn-outline-light btn-lg">Повідомити про стан</a>
    </div>

    <div class="skyline" aria-hidden="true">
        @foreach (var b in buildings)
        {
            <div class="building" style="--cols:@b[0]">
                @for (var w = 0; w < b[0] * b[1]; w++, index++)
                {
                    if (lit.TryGetValue(index, out var n))
                    {
                        <span class="win lit" style="--i:@n"></span>
                    }
                    else if (blinking.Contains(index))
                    {
                        <span class="win blink" style="--d:@(random.Next(40, 90))s;--o:@(random.Next(5, 40))s"></span>
                    }
                    else
                    {
                        <span class="win"></span>
                    }
                }
            </div>
        }
    </div>
    <p class="hero-count">Світло є в <strong>@Model.PointsLit</strong> з @Model.PointsTotal пунктів.</p>
</section>

<div class="row g-4 g-lg-5">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-baseline mb-3">
            <h2 class="mb-0">Пункти</h2>
            <a asp-controller="Points" asp-action="Index">Усі пункти</a>
        </div>
        <ul class="point-list">
            @foreach (var p in Model.Points)
            {
                <partial name="~/Views/Points/_PointRow.cshtml" model="p" />
            }
        </ul>
    </div>
    <div class="col-lg-4">
        <h2 class="mb-3">Свіжі звіти</h2>
        <ul class="feed">
            @foreach (var r in Model.LatestReports)
            {
                <li>
                    <div class="feed-top">
                        <a asp-controller="Points" asp-action="Details" asp-route-id="@r.PointId">@r.Point?.Name</a>
                        <partial name="_StatusBadge" model="r.Status" />
                    </div>
                    <small>@r.CreatedAt.ToLocalString(), у пункті @r.Occupancy осіб</small>
                </li>
            }
        </ul>
        <div class="stat-line">
            <span><b>@Model.OperatorsTotal</b>операторів</span>
            <span><b>@Model.ReportsToday</b>звітів за добу</span>
        </div>
    </div>
</div>
