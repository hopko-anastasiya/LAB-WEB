@model Operator
@{
    ViewData["Title"] = $"Редагування: {Model.Name}";
}
<h1 class="mb-4">Редагування оператора</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel">
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Зберегти</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Скасувати</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
