@model Operator
@{
    ViewData["Title"] = Model.Name;
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Оператори</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>
<div class="panel mb-4">
    <h1>@Model.Name</h1>
    @if (!string.IsNullOrEmpty(Model.Organization))
    {
        <p class="text-muted mb-2">@Model.Organization</p>
    }
    <div class="d-flex flex-wrap gap-3">
        <a href="tel:@Model.Phone"><i class="bi bi-telephone"></i> @Model.Phone</a>
        @if (!string.IsNullOrEmpty(Model.Email))
        {
            <a href="mailto:@Model.Email"><i class="bi bi-envelope"></i> @Model.Email</a>
        }
        @if (!string.IsNullOrEmpty(Model.Telegram))
        {
            <a href="https://t.me/@Model.Telegram.TrimStart('@')" target="_blank" rel="noopener"><i class="bi bi-telegram"></i> @Model.Telegram</a>
        }
    </div>
    <div class="mt-3 d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Редагувати</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Видалити</a>
    </div>
</div>
<h2 class="h5">Пункти оператора (@Model.Points.Count)</h2>
<ul class="list-group">
    @foreach (var p in Model.Points.OrderBy(p => p.Name))
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span><a asp-controller="Points" asp-action="Details" asp-route-id="@p.Id">@p.Name</a> <small class="text-muted d-block">@p.Settlement, @p.Address</small></span>
            <partial name="_StatusBadge" model="p.Status" />
        </li>
    }
    @if (Model.Points.Count == 0)
    {
        <li class="list-group-item text-muted">Пунктів поки немає.</li>
    }
</ul>
