@model List<Operator>
@{
    ViewData["Title"] = "Оператори";
}
<div class="page-head">
    <h1>Оператори</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Додати оператора</a>
</div>
<form method="get" class="input-group mb-3" style="max-width: 420px">
    <input name="q" value="@ViewData["q"]" class="form-control" placeholder="Ім'я або організація" />
    <button class="btn btn-outline-primary"><i class="bi bi-search"></i></button>
</form>
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Ім'я / назва</th><th>Організація</th><th>Телефон</th><th>Email</th><th class="text-center">Пунктів</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@o.Id">@o.Name</a></td>
                    <td>@o.Organization</td>
                    <td class="text-nowrap"><a href="tel:@o.Phone">@o.Phone</a></td>
                    <td>@o.Email</td>
                    <td class="text-center">@o.Points.Count</td>
                    <td class="text-nowrap text-end">
                        @if (CurrentUser.CanEdit(o.CommunityId))
                        {
                            <a asp-action="Edit" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary" title="Редагувати"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@o.Id" class="btn btn-sm btn-outline-danger" title="Видалити"><i class="bi bi-trash"></i></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Model.Count == 0)
{
    <div class="alert alert-info">Операторів не знайдено.</div>
}
