@model StatusReport
@{
    ViewData["Title"] = "Звіт про стан";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Звіти</a></li>
        <li class="breadcrumb-item active" aria-current="page">Звіт #@Model.Id</li>
    </ol>
</nav>
<div class="row g-4">
    <div class="col-md-7">
        <h1>
            <a asp-controller="Points" asp-action="Details" asp-route-id="@Model.PointId" class="text-decoration-none">@Model.Point?.Name</a>
            <partial name="_StatusBadge" model="Model.Status" />
        </h1>
        <p class="text-muted">@Model.CreatedAt.ToLocalString(), автор: @(Model.AuthorName ?? "не вказано")</p>
        <ul class="list-group mb-3">
            <li class="list-group-item d-flex justify-content-between">@Html.DisplayNameFor(m => m.HasElectricity) <partial name="_Flag" model="Model.HasElectricity" /></li>
            <li class="list-group-item d-flex justify-content-between">@Html.DisplayNameFor(m => m.HasInternet) <partial name="_Flag" model="Model.HasInternet" /></li>
            <li class="list-group-item d-flex justify-content-between">@Html.DisplayNameFor(m => m.HasHeating) <partial name="_Flag" model="Model.HasHeating" /></li>
            <li class="list-group-item d-flex justify-content-between">@Html.DisplayNameFor(m => m.Occupancy) <strong>@Model.Occupancy</strong></li>
        </ul>
        @if (!string.IsNullOrWhiteSpace(Model.Comment))
        {
            <blockquote class="blockquote border-start border-3 ps-3"><p class="mb-0">@Model.Comment</p></blockquote>
        }
        @if (CurrentUser.CanEdit(Model.Point?.Operator?.CommunityId))
        {
            <div class="d-flex gap-2 mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Редагувати</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Видалити</a>
            </div>
        }
    </div>
    @if (!string.IsNullOrEmpty(Model.PhotoPath))
    {
        <div class="col-md-5">
            <img src="@Model.PhotoPath" class="img-fluid rounded shadow-sm" alt="Фото до звіту" />
        </div>
    }
</div>
