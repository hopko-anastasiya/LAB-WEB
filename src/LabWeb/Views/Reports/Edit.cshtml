@model ReportFormViewModel
@{
    ViewData["Title"] = "Редагування звіту";
}
<h1 class="mb-4">Редагування звіту #@Model.Report.Id</h1>
<form asp-action="Edit" asp-route-id="@Model.Report.Id" method="post" enctype="multipart/form-data" class="panel">
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Зберегти</button>
        <a asp-action="Details" asp-route-id="@Model.Report.Id" class="btn btn-outline-secondary">Скасувати</a>
    </div>
</form>
@section Head { <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/css/select2.min.css" /> }
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/js/select2.min.js"></script>
    <script src="~/js/autocomplete.js" asp-append-version="true"></script>
}
