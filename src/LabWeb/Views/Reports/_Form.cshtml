@model ReportFormViewModel
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="Report.Id" />
<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Report.PointId" class="form-label"></label>
        <select asp-for="Report.PointId" asp-items="Model.Points" class="form-select">
            <option value="">— оберіть пункт —</option>
        </select>
        <span asp-validation-for="Report.PointId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Report.Status" class="form-label"></label>
        <select asp-for="Report.Status" asp-items="Html.GetEnumSelectList<PointStatus>()" class="form-select"></select>
    </div>

    <div class="col-12 d-flex flex-wrap gap-4">
        <div class="form-check form-switch">
            <input asp-for="Report.HasElectricity" class="form-check-input" role="switch" />
            <label asp-for="Report.HasElectricity" class="form-check-label"></label>
        </div>
        <div class="form-check form-switch">
            <input asp-for="Report.HasInternet" class="form-check-input" role="switch" />
            <label asp-for="Report.HasInternet" class="form-check-label"></label>
        </div>
        <div class="form-check form-switch">
            <input asp-for="Report.HasHeating" class="form-check-input" role="switch" />
            <label asp-for="Report.HasHeating" class="form-check-label"></label>
        </div>
    </div>

    <div class="col-md-4">
        <label asp-for="Report.Occupancy" class="form-label"></label>
        <input asp-for="Report.Occupancy" class="form-control" />
        <span asp-validation-for="Report.Occupancy" class="text-danger small"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Report.AuthorName" class="form-label"></label>
        <input asp-for="Report.AuthorName" class="form-control" />
    </div>
    <div class="col-12">
        <label asp-for="Report.Comment" class="form-label"></label>
        <textarea asp-for="Report.Comment" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Report.Comment" class="text-danger small"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Photo" class="form-label"></label>
        <input asp-for="Photo" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" data-preview="#photoPreview" />
        <span asp-validation-for="Photo" class="text-danger small"></span>
    </div>
    <div class="col-md-4 d-flex align-items-end gap-3">
        <img id="photoPreview" src="@(Model.Report.PhotoPath ?? Url.Content("~/img/placeholder.svg"))" class="rounded thumb" alt="Попередній перегляд" />
        @if (!string.IsNullOrEmpty(Model.Report.PhotoPath))
        {
            <div class="form-check">
                <input asp-for="RemovePhoto" class="form-check-input" />
                <label asp-for="RemovePhoto" class="form-check-label"></label>
            </div>
        }
    </div>
</div>
